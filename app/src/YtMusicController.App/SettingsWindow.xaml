<Window x:Class="YtMusicController.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YtMusicController Settings" Height="550" Width="620"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Local API" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="135"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Active API URL" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox Grid.Column="1" x:Name="ActiveApiUrlBox" IsReadOnly="True" Padding="6"/>
            <Button Grid.Column="2" Content="Copy URL" Margin="8,0,0,0" Padding="12,5"
                    Click="CopyApiUrl_Click"/>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="135"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Preferred port" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="PortBox" Width="100" HorizontalAlignment="Left"/>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="135"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Volume step (%)" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="VolumeStepBox" Width="100" HorizontalAlignment="Left">
                <ComboBoxItem Content="1"/>
                <ComboBoxItem Content="2"/>
                <ComboBoxItem Content="5"/>
                <ComboBoxItem Content="10"/>
            </ComboBox>
        </Grid>
        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="135"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Volume control" VerticalAlignment="Top" Margin="0,5,0,0"/>
            <StackPanel Grid.Column="1">
                <ComboBox x:Name="VolumeControlMethodBox" Width="300" HorizontalAlignment="Left">
                    <ComboBoxItem Content="Player API (precise steps)" Tag="PlayerApi"/>
                    <ComboBoxItem Content="Keyboard shortcuts (native feedback)" Tag="KeyboardShortcuts"/>
                </ComboBox>
                <TextBlock Margin="0,5,0,0" Foreground="Gray" TextWrapping="Wrap"
                           Text="Keyboard mode uses YouTube Music's own volume increment. Exact set-volume requests still use the Player API."/>
            </StackPanel>
        </Grid>
        <CheckBox Grid.Row="5" x:Name="MinimizeToTrayBox" Content="Close to notification area"
                  Margin="135,0,0,12"/>
        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="135,0,0,12">
            <CheckBox x:Name="ShowDebugLogWindowBox" Content="Show debug log window"
                      VerticalAlignment="Center" Checked="DebugWindowSetting_Changed"
                      Unchecked="DebugWindowSetting_Changed"/>
            <Button x:Name="OpenDebugLogButton" Content="Open now" Margin="14,0,0,0"
                    Padding="12,4" Click="OpenDebugLog_Click"/>
        </StackPanel>
        <TextBlock Grid.Row="7" Text="Bearer token (keep this private)" Margin="0,0,0,5"/>
        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TokenBox" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Padding="6"/>
            <Button Grid.Column="1" Content="Copy" Margin="8,0,0,0" Padding="12,5"
                    VerticalAlignment="Top" Click="CopyToken_Click"/>
            <Button Grid.Column="2" Content="Regenerate" Margin="8,0,0,0" Padding="12,5"
                    VerticalAlignment="Top" Click="RegenerateToken_Click"/>
        </Grid>
        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Save" Width="80" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
