<Window x:Class="YtMusicController.App.Diagnostics.DebugLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YtMusicController Debug Log" Height="560" Width="1050"
        MinHeight="320" MinWidth="680" Background="#101010"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="AutoScrollBox" Content="Auto-scroll" IsChecked="True"
                      Foreground="#E8E8E8" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="Copy all" Padding="12,4" Margin="0,0,8,0" Click="CopyAll_Click"/>
            <Button Content="Clear panel" Padding="12,4" Margin="0,0,8,0" Click="Clear_Click"/>
            <Button Content="Open log folder" Padding="12,4" Click="OpenLogFolder_Click"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText"
                   Foreground="#9A9A9A" Margin="0,8,0,0"/>
        <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True"
                 FontFamily="Consolas" FontSize="12" Foreground="#E6E6E6"
                 Background="#171717" BorderBrush="#3A3A3A" Padding="8"
                 TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"/>
    </DockPanel>
</Window>
