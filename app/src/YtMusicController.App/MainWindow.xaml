<Window x:Class="YtMusicController.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="YouTube Music Controller" Height="780" Width="1200"
        MinHeight="520" MinWidth="800"
        Background="#111111" Icon="/Assets/AppIcon.ico">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#202020" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ConnectionText" Text="Starting YouTube Music…"
                               Foreground="#E8E8E8" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PlayerText" Text="Player not ready"
                               Foreground="#AAAAAA" FontSize="11"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="TrackText" Text="No track"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="White" TextTrimming="CharacterEllipsis" Margin="16,0"/>
                <Button Grid.Column="2" Content="Settings" Padding="14,5"
                        Click="Settings_Click"/>
            </Grid>
        </Border>
        <wv2:WebView2 x:Name="MusicWebView"/>
    </DockPanel>
</Window>
