{
	"name": "companion-module-ytmdesktop",
	"version": "0.3.3",
	"description": "Bitfocus Companion control for the local YtMusicController WebView2 app",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"build": "rimraf dist && tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"format": "prettier -w .",
		"lint": "eslint .",
		"package": "npm run build && companion-module-build",
		"test": "npm run build && node --test test/*.test.mjs",
		"verify": "npm run lint && npm test"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-ytmdesktop.git"
	},
	"engines": {
		"node": "^22.20 || >=24"
	},
	"dependencies": {
		"@companion-module/base": "2.0.4",
		"@julusian/image-rs": "^2.1.1"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.0.1",
		"@types/node": "^22.19.17",
		"eslint": "^9.39.4",
		"prettier": "^3.8.3",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.59.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "pnpm@11.19.0"
}
